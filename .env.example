# Environment variables the app reads. All are optional; each overrides the matching key in config.json
# (see docs/configuration.md). The app does not load this file itself: export the variables, or put them in
# a systemd unit / EnvironmentFile. Never commit real values.

# Path to the config file (default: <repo>/config.json, then config.jsonc)
#HERMES_WEB_CONFIG=
# server.port
#HERMES_WEB_PORT=8300
# server.hosts (comma separated)
#HERMES_WEB_HOSTS=127.0.0.1
# server.allowedHosts (comma separated public hostnames)
#HERMES_WEB_ALLOWED_HOSTS=app.example.com
# agents (comma separated Hermes profile names)
#HERMES_WEB_AGENTS=default
# hermesRoot
#HERMES_ROOT=
# Data directory (login record, sessions, feed database). Default: ./data
#HERMES_WEB_DATA_DIR=
# Directory served as the client. Default: ./public
#HERMES_WEB_PUBLIC_DIR=
# server.sessionDays
#HERMES_WEB_SESSION_DAYS=30
# server.cookieSecure (1 = true)
#HERMES_WEB_COOKIE_SECURE=0
# server.trustCloudflare (1 = true)
#HERMES_WEB_TRUST_CLOUDFLARE=0
# server.orphanStopMinutes
#HERMES_WEB_ORPHAN_STOP_MIN=20
# push.subject
#HERMES_WEB_PUSH_SUBJECT=mailto:admin@example.invalid

# Feed: 1 turns the background collection off
#HERMES_WEB_FRESH_OFF=0
# Feed: 1 uses offline stand-ins, no network (tests and sandboxes)
#HERMES_WEB_FRESH_OFFLINE=0
# Feed: requests per minute per model for the rate limiter
#HERMES_WEB_FRESH_RPM=

# Used by scripts/fresh-bootstrap.mjs: base URL of the running app
#HERMES_WEB_URL=http://127.0.0.1:8300

# Example secret referenced from a provider config as "env:EXAMPLE_API_KEY"
#EXAMPLE_API_KEY=
