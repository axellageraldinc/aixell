# systemd --user unit for the Hermes gateway of profile <profile> (it serves the API server that aixell talks to).
# Prefer `hermes --profile <profile> gateway install` (Hermes writes its own unit); this file is a reference copy.
[Unit]
Description=Hermes Agent Gateway (profile <profile>)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.hermes/hermes-agent/.hermes/bin/hermes --profile <profile> gateway run
WorkingDirectory=%h/.hermes/profiles/<profile>
Environment=HERMES_HOME=%h/.hermes/profiles/<profile>
Environment=HERMES_SUPERVISED_CHILD=1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
