# Caddy reverse proxy for the web app (automatic HTTPS).
# Replace <hostname> with your public name and <port> with the local app port.
# Caddy obtains and renews the certificate for <hostname> automatically.
<hostname> {
	encode zstd gzip

	# flush_interval -1 turns off response buffering, so SSE events and
	# streamed chat replies reach the browser as they are produced.
	reverse_proxy 127.0.0.1:<port> {
		flush_interval -1
		transport http {
			dial_timeout 10s
			response_header_timeout 300s
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}
